# ═══════════════════════════════════════════════════════════════
# Sunbula Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file: cp .env.example .env
# Then fill in your actual values in .env
# NEVER commit the .env file to Git!

# Database
DB_PASSWORD=YourStrong@Password123

# JWT Authentication
JWT_SECRET=YOUR_STRONG_HEX_OR_BASE64_SECRET_KEY_AT_LEAST_256_BITS_LONG

# Email (Gmail App Password — NOT your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# FTP Deployment (MonsterASP) — only needed in CI/CD
# FTP_SERVER=ftp.monster-asp.net
# FTP_USERNAME=your-username
# FTP_PASSWORD=your-password
