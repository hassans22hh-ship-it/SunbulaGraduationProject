{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "AutoMigrate": true
  },
  "ConnectionStrings": {
    "SunbulaDb": "Server=localhost;Database=Sunbula;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=30;MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "SecretKey": "YOUR_STRONG_HEX_OR_BASE64_SECRET_KEY_AT_LEAST_256_BITS_LONG",
    "Issuer": "https://localhost:7217;http://localhost:5142",
    "Audience": "SunbulaClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "EmailSettings": {
    "Email": "your-email@gmail.com",
    "Password": "your-gmail-app-password",
    "Host": "smtp.gmail.com",
    "Port": 587
  },
  "Cors": {
    "AllowedOrigins": [
      "https://sunbula-front-end.vercel.app",
      "http://localhost:4200",
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "AllowedHosts": "*"
}
